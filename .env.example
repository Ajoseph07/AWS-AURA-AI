# AURA AI environment variables — copy this file to ".env" and fill in your values.
# ".env" is gitignored and must NEVER be committed.

# Google Maps API key (Maps JavaScript + Directions + Geocoding APIs enabled).
# Restrict the key in Google Cloud Console to your domain + those three APIs.
GOOGLE_MAPS_API_KEY=AIzaSyAlpYgqjpOf8nlYgdGoS97aHqF7SYNrdoY

# Optional: use live National Weather Service hazard alerts instead of the
# built-in simulated scenario. "1" to enable. The NWS API needs no key.
AURA_LIVE_HAZARDS=0

# Optional: Amazon Bedrock for live message extraction (set to "1" to enable).
USE_BEDROCK=0
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REGION=us-east-2
