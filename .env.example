# AURA AI environment variables — copy this file to ".env" and fill in values.
# ".env" is gitignored and must NEVER be committed.
#
# The map uses Leaflet + OpenStreetMap and needs NO API key. Routing uses the
# free, keyless OSRM public service. Everything below is optional.

# Optional: use live National Weather Service hazard alerts instead of the
# built-in simulated scenario. "1" to enable. The NWS API needs no key.
AURA_LIVE_HAZARDS=0

# Optional: a self-hosted OSRM routing server (defaults to the public demo).
# OSRM_URL=https://router.project-osrm.org

# Optional: Amazon Bedrock for live message extraction (set to "1" to enable).
USE_BEDROCK=0
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REGION=us-east-2
